{
  "name": "@diagrampilot/website",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/sync-public-docs.mjs",
    "predev": "node scripts/sync-public-docs.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:docs && npm run build:landing && npm run build:landing:ssr && node scripts/render-landing.mjs",
    "build:docs": "astro build",
    "build:landing": "vite build",
    "build:landing:ssr": "vite build --ssr src/landing/ssr.tsx --outDir dist/.vite-ssr",
    "check:visual": "node scripts/check-visual-quality.mjs",
    "test": "node --test --test-concurrency=1 ../test/website-*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "@tanstack/react-router": "^1.170.15",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.16"
  }
}
